-- Function to teleport to nearest item
local function teleportToNearestItem()
    if not canTeleport then 
        statusLabel.Text = "⏳ Teleport on cooldown..."
        return 
    end
    
    canTeleport = false
    
    local character = Player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        statusLabel.Text = "❌ Character not found!"
        canTeleport = true
        return
    end

    local playerPosition = character.HumanoidRootPart.Position
    local nearestItem = nil
    local nearestDistance = math.huge
    local nearestItemName = ""
    
    statusLabel.Text = "🔍 Finding nearest item..."
    
    -- Search through workspace for nearest target item
    for _, item in pairs(workspace:GetDescendants()) do
        if targetItems[item.Name] then
            local position = nil
            
            if item:IsA("BasePart") then
                position = item.Position
            elseif item:IsA("Model") then
                local primaryPart = item.PrimaryPart or item:FindFirstChildOfClass("BasePart")
                if primaryPart then
                    position = primaryPart.Position
                end
            end
            
            if position then
                local distance = (playerPosition - position).Magnitude
                if distance < nearestDistance then
                    nearestDistance = distance
                    nearestItem = position
                    nearestItemName = item.Name
                end
            end
        end
    end
    
    if nearestItem then
        statusLabel.Text = "🚀 Teleporting to nearest " .. nearestItemName .. " (" .. math.floor(nearestDistance) .. " studs away)"
        teleportToPosition(nearestItem, nearestItemName)
    else
        statusLabel.Text = "❌ No target items found!"
    end
    
    -- Reset cooldown
    task.spawn(function()
        task.wait(COOLDOWN)
        canTeleport = true
    end)
end

